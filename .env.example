# Strix MCP credentials.
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# `.env` is gitignored — never commit it, and never paste your key anywhere else.

# LLM provider + model string. Examples:
#   openrouter/z-ai/glm-5.3
#   vercel_ai_gateway/zai/glm-5.3
#   anthropic/claude-opus-5-5
#   openai/gpt-6.1-sol
STRIX_LLM=openrouter/z-ai/glm-5.3

# API key for the provider above.
LLM_API_KEY=

# Optional: custom API base (e.g. local Ollama / LMStudio).
# LLM_API_BASE=http://localhost:11434

# Optional: path to the strix binary if it is not on PATH or ~/.local/bin.
# STRIX_BIN=/usr/local/bin/strix

# Optional: where scan runs are stored (default: ./runs next to the server).
# STRIX_MCP_HOME=
